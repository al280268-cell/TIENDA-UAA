# ============================================================
# FERIA UAA — RETO E-COMMERCE — Variables de Entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA subas .env a Git/GitHub
# ============================================================

# ---- PROVEEDOR DE TIEMPO REAL ----
# 'ably'  → usar Ably como WebSocket (recomendado para Vercel)
# 'native' → usar WebSockets nativos (solo para servidor local)
REALTIME_PROVIDER=native

# ---- ABLY (necesario si REALTIME_PROVIDER=native) ----
# Consigue tu API key gratis en https://ably.com
# Ve a App → API Keys → copia la key completa (format: xxxxx.yyyyy:zzzzz)
ABLY_API_KEY=

# La clave pública para el frontend (solo capacidades de suscripción)
# En Ably: App → API Keys → crear key con solo "subscribe" capability
ABLY_CLIENT_KEY=

# ---- ADMINISTRADOR ----
# Contraseña para acceder al panel de administrador (/admin)
ADMIN_PASSWORD=uaa2026admin

# ---- SEGURIDAD JWT ----
# Secreto para firmar tokens de jugadores y admin
# Genera uno aleatorio: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-en-produccion-con-valor-aleatorio-seguro

# ---- BASE DE DATOS ----
# Para desarrollo local: SQLite (no requiere configuración extra)
DATABASE_URL=sqlite+aiosqlite:///./game.db

# Para producción con Supabase (recomendado para multi-dispositivo):
# DATABASE_URL=postgresql+asyncpg://user:password@db.supabase.co:5432/postgres

# ---- CONFIGURACIÓN DEL JUEGO ----
# Máximo de jugadores por partida por defecto
MAX_PLAYERS_DEFAULT=20

# Duración por defecto en segundos (480 = 8 minutos)
GAME_DURATION_DEFAULT=180

# ---- CORS ----
# Para desarrollo local: * (permite todo)
# Para producción: especifica el dominio de Vercel
# CORS_ORIGINS=https://tu-proyecto.vercel.app,https://feria-uaa.vercel.app
CORS_ORIGINS=*
